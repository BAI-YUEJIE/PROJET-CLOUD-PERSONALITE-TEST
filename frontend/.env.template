# Configuration d'environnement pour le frontend (Vite)
# Copier ce fichier en `.env` et remplacer la valeur par l'URL réelle.
#
# Après un déploiement OpenTofu :
#   cd infra && tofu apply
#   → récupérer la valeur de l'output "api_endpoint"
#   → la coller ci-dessous dans VITE_API_URL
#
# Exemple production :
#   VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
#
# Exemple local avec LocalStack (port 4566) :
#   VITE_API_URL=http://localhost:4566/dev

VITE_API_URL=https://REMPLACER_PAR_OUTPUT_TOFU/dev
